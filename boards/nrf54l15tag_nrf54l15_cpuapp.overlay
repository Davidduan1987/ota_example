&cpuapp_rram {
    reg = <0x0 DT_SIZE_K(1524)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 0x00020000>;
        };

        slot0_partition: partition@20000 {
            label = "image-0";
            reg = <0x00020000 0x00128000>;
        };

        storage_partition: partition@148000 {
            label = "storage";
            reg = <0x00148000 0x00003000>;
        };

        ring_storage: partition@14b000 {
            label = "ring_storage";
            reg = <0x0014b000 0x00032000>;
        };
    };
};

&cpuapp_sram {
    reg = <0x20000000 DT_SIZE_K(256)>;
    ranges = <0x0 0x20000000  0x40000>;
};

/* External flash for MCUboot secondary slot + user data */
&mx25r64 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0x00000000 0x00128000>;
		};

		ido_storage_partition: partition@128000 {
			label = "ido_storage_partition";
			reg = <0x00128000 0x006d8000>;
		};
	};
};
